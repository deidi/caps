{
  "name": "caps-server",
  "version": "1.0.0",
  "description": "Local-network-first photo sharing server for Caps",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "launch": "node src/launcher.js",
    "dev": "node --watch src/index.js",
    "package:win": "npx -y @yao-pkg/pkg src/launcher.js --targets node20-win-x64 --output dist/caps-server.exe"
  },
  "bin": "src/launcher.js",
  "pkg": {
    "assets": [
      "../../client/dist/**/*",
      "data/**/*"
    ]
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "ws": "^8.18.0"
  }
}
